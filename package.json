{
  "name": "cgbl-design-system",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "^5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "storybook": "storybook dev -p 6006 --stats-json ./",
    "doctor": "npx storybook doctor",
    "build-storybook": "storybook build",
    "chromatic": "node --env-file=.env -e 'process.env.CHROMATIC_PROJECT_TOKEN && require(\"child_process\").spawnSync(\"npx\", [\"chromatic\", \"--project-token=\" + process.env.CHROMATIC_PROJECT_TOKEN], { stdio: \"inherit\", shell: true })'",
    "find:threshold": "node ./find-diff-threshold.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:storybook/recommended"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/parser": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/traverse": "^7.28.4",
    "@chromatic-com/storybook": "5.2.1",
    "@playwright/test": "^1.48.0",
    "@storybook/addon-a11y": "10.4.1",
    "@storybook/addon-docs": "10.4.1",
    "@storybook/addon-links": "10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-onboarding": "10.4.1",
    "@storybook/addon-vitest": "10.4.1",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
    "@storybook/react-webpack5": "10.4.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "babel-loader": "^10.0.0",
    "baseline-browser-mapping": "^2.9.14",
    "chromatic": "^13.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint-plugin-storybook": "10.4.1",
    "glob": "^11.0.3",
    "prop-types": "^15.8.1",
    "storybook": "10.4.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.93.0"
  },
  "packageManager": "yarn@1.22.22",
  "overrides": {
    "storybook": "$storybook",
    "typescript": "^5.9.3"
  }
}
